# Dynamic MCP Server Environment Variables

# AgentStudio API URL
AGENTSTUDIO_API_URL=http://localhost:8000

# Internal API key for secure communication
MCP_INTERNAL_API_KEY=your-internal-api-key-here

# Server configuration
HOST=0.0.0.0
PORT=3000
DEBUG=false

# Redis URL for token caching (optional)
# REDIS_URL=redis://localhost:6379/0

# Tool refresh interval in seconds
TOOL_REFRESH_INTERVAL=60

# Request timeouts
DEFAULT_TIMEOUT=30
MAX_TIMEOUT=300
