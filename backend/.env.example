# Application
APP_NAME=AgentStudio
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# Server
API_V1_PREFIX=/api/v1
API_BASE_URL=  # e.g., https://agentstudio365.com - used for deployment URLs (Azure Front Door domain)
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentstudio
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# CORS
# For production with Azure Front Door, add your custom domain:
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://agentstudio365.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
